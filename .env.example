# Facultatif : chemin vers une base SQLite locale persistante.
# DATABASE_PATH=.data/academie.sqlite

# Active les offres et l'expiration simulées. Aucun paiement n'est effectué.
# Toujours false pour une installation destinée à la commercialisation.
DEMO_MODE=true

# Mettre true avec HTTPS. En développement HTTP local : false.
COOKIE_SECURE=false
